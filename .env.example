# Supabase browser-safe configuration. Copy this file to .env.local and fill in values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
LLM_API_KEY=

# Server-only custom email delivery. QQ SMTP uses an authorization code, not the QQ password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Must be listed in Supabase Auth Redirect URLs, for example http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
