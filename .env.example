# Supabase browser-safe configuration. Copy this file to .env.local and fill in values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DISCOVERY_CONTEXT_ENCRYPTION_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_ENABLED=false
# Required only when DEEPSEEK_ENABLED=true; keep this server-only and rotate it.
DISCOVERY_LIMIT_HASH_SALT=
TRUST_PROXY=false
# Optional DeepSeek controls. Defaults are 10/min anonymous, 20/min authenticated,
# 100/day per identity, 1,000/day provider, 10 global concurrent attempts.
DEEPSEEK_ANONYMOUS_PER_MINUTE=10
DEEPSEEK_AUTHENTICATED_PER_MINUTE=20
DEEPSEEK_IDENTITY_DAILY_LIMIT=100
DEEPSEEK_PROVIDER_DAILY_LIMIT=1000
DEEPSEEK_GLOBAL_CONCURRENCY=10
DEEPSEEK_CIRCUIT_FAILURE_THRESHOLD=5
DEEPSEEK_CIRCUIT_COOLDOWN_SECONDS=60
