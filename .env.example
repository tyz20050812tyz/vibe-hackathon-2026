# Supabase browser-safe configuration. Copy this file to .env.local and fill in values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DISCOVERY_CONTEXT_ENCRYPTION_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
